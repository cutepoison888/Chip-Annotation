{
  "manifest_version": 3,
  "name": "芯标注 · IC采购助手",
  "version": "0.10.2",
  "description": "IC交易网 / 正能量电子网 / 华强电子网采购助手：QQ 私人/企业识别与一键复制、询价记录本、批量询价、货源对比（立创/云汉/圣禾堂/贸泽/得捷）、库存与价格变化提醒。开源免费，所有数据只存本机。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    },
    "default_title": "芯标注 · IC采购助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "clipboardWrite",
    "notifications"
  ],
  "host_permissions": [
    "*://*.hqew.com/*",
    "*://*.ic.net.cn/*",
    "https://*.alicdn.com/*",
    "https://*.aliyuncs.com/*",
    "https://*.bomman.com/*",
    "https://*.digikey.cn/*",
    "https://*.digikey.com/*",
    "https://*.ickey.cn/*",
    "https://*.mouser.cn/*",
    "https://*.mouser.com/*",
    "https://*.oksht.com/*",
    "https://admin.qidian.qq.com/*",
    "https://alimg.szlcsc.com/*",
    "https://item.szlcsc.com/*",
    "https://overseas.szlcsc.com/*",
    "https://s.taobao.com/*",
    "https://search.ickey.cn/*",
    "https://so.szlcsc.com/*",
    "https://www.bomman.com/*",
    "https://www.digikey.cn/*",
    "https://www.mouser.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ic.net.cn/*",
        "*://*.bom.ai/*",
        "*://*.hqew.com/*"
      ],
      "js": [
        "content/early.js"
      ],
      "css": [
        "content/ic.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.bom.ai/*",
        "*://*.ic.net.cn/*",
        "*://*.hqew.com/*"
      ],
      "js": [
        "build.js",
        "lib/record.js",
        "content/ic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.qidian.qq.com/static_proxy/b2b-qq/wpa-link/*",
        "https://admin.qidian.qq.com/template/*qr-code-jump*"
      ],
      "js": [
        "content/qidian.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://s.taobao.com/*",
        "https://search.ickey.cn/*",
        "https://so.szlcsc.com/*",
        "https://www.bomman.com/*",
        "https://www.digikey.cn/*",
        "https://www.mouser.cn/*"
      ],
      "js": [
        "lookup/reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.bom.ai/*",
        "*://*.hqew.com/*"
      ],
      "js": [
        "content/adblock.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://so.szlcsc.com/*",
        "https://search.ickey.cn/*",
        "https://www.bomman.com/*",
        "https://bomman.com/*",
        "https://www.mouser.cn/*",
        "https://www.digikey.cn/*"
      ],
      "js": [
        "content/srcbell.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "records.html",
        "records.js",
        "ui.css",
        "lib/record.js"
      ],
      "matches": [
        "*://*.ic.net.cn/*",
        "*://*.bom.ai/*",
        "*://*.hqew.com/*"
      ]
    }
  ],
  "version_name": "0.10.2 通用版"
}
